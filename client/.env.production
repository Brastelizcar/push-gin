# Dirección del servidor del juego para la versión publicada en internet.
# Cámbiala por la URL que te dé Render (la misma, pero empezando con wss:// en lugar de https://).
# Ejemplo: si Render te da https://push-gin-server-abcd.onrender.com  →  wss://push-gin-server-abcd.onrender.com
VITE_SERVER_URL=wss://push-gin-server.onrender.com
